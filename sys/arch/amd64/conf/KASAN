#	$OpenBSD$
#
# GENERIC.MP-equivalent kernel with the kernel address sanitizer.
# MULTIPROCESSOR is spelled out (rather than including GENERIC.MP)
# so the per-CPU pool cache and other MP-only paths run under KASAN.

include "arch/amd64/conf/GENERIC"

option MULTIPROCESSOR

option KASAN
option NO_PROPOLICE

makeoptions DEBUG="-g"
makeoptions COPTIMIZE="-Og -g -fno-omit-frame-pointer"

# A KASAN report is long and is printed first in a fault, so the panic
# backtrace and the next boot's device probe can wrap it out of the default
# 128K message buffer before it can be read from dmesg after the reboot.
# Enlarge the ring (param.h's MSGBUFSIZE is -D-overridable) so the report
# survives into the following boot.
makeoptions COPTS="-DMSGBUFSIZE=0x100000"	# 1MB message buffer

cpu*		at mainbus?
